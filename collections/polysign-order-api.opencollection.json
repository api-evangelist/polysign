{
  "opencollection": "1.0.0",
  "info": {
    "name": "Polysign Order API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/v1/auth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "order",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the detail of an order on AtomicNet by its id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "The identifier of the order."
              }
            ]
          },
          "docs": "Get the detail of an order on AtomicNet by its id."
        },
        {
          "info": {
            "name": "Get the detail of all order on AtomicNet.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/orders/list",
            "params": [
              {
                "name": "status",
                "value": "pending",
                "type": "query",
                "description": "The specified status to be filtered on."
              },
              {
                "name": "role",
                "value": "exchange",
                "type": "query",
                "description": "The specified role to be filtered on.\nAtomicNet node will determine if an order is local by the role it is\nplaying.\n"
              }
            ]
          },
          "docs": "Get the detail of all order on AtomicNet."
        },
        {
          "info": {
            "name": "Publish a new order to AtomicNet.\nThe authorizations will be acquired if not provided before publishing.\n",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/orders/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Publish a new order to AtomicNet.\nThe authorizations will be acquired if not provided before publishing.\n"
        },
        {
          "info": {
            "name": "Get all status updates associated with an order by its id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/order_status_updates/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "The identifier of the order."
              }
            ]
          },
          "docs": "Get all status updates associated with an order by its id."
        },
        {
          "info": {
            "name": "Submit order to AtomicNet node.\n",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/orders/submit_order",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit order to AtomicNet node.\n"
        }
      ]
    }
  ],
  "bundled": true
}