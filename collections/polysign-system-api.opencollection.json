{
  "opencollection": "1.0.0",
  "info": {
    "name": "Polysign System API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/v1/auth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "system",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the status of all circuit breakers on the server.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/system/circuit_breakers"
          },
          "docs": "Get the status of all circuit breakers on the server."
        },
        {
          "info": {
            "name": "Basic health check.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/system/ping"
          },
          "docs": "Basic health check."
        },
        {
          "info": {
            "name": "Get the version of the server.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/system/version"
          },
          "docs": "Get the version of the server."
        },
        {
          "info": {
            "name": "Deep health check.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/system/deep_ping"
          },
          "docs": "Deep health check."
        }
      ]
    }
  ],
  "bundled": true
}